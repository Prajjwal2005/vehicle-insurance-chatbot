# ── Insurance System API: configuration ──
# Copy this file to ".env" and adjust as needed.

# Local development uses SQLite — no database server required.
DATABASE_URL=sqlite+aiosqlite:///./insurance.db

# For the containerised / production setup, swap to PostgreSQL instead:
# DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance

APP_NAME=Insurance System API
